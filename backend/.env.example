# Database (required) - PostgreSQL connection string
# For Render: Use the Internal Database URL from your PostgreSQL instance
# For Neon: Use the connection string from your Neon dashboard
DATABASE_URL=postgresql://user:password@host:5432/careerlens

# JWT Secret Key (required) - Generate a strong random string
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-secret-key

# JWT Token Expiration (optional, defaults to 30 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend URL (for CORS - set to your deployed frontend URL)
FRONTEND_URL=https://your-frontend.onrender.com

# Port (set automatically by most hosting providers)
PORT=8000
