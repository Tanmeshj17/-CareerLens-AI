# =================================================================
# CareerLens AI Backend Environment Configuration Example
# =================================================================

# Environment Mode: 'development', 'staging', or 'production'
ENVIRONMENT=production

# Application Secret Key (Must be set to a strong random key in production)
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-key-in-production

# JWT Expiration in minutes (Default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection URL (PostgreSQL)
# Format: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=postgresql://careerlens_user:secure_password@localhost:5432/careerlens_db

# Frontend Application Origin URL (For CORS Whitelist)
FRONTEND_URL=https://careerlens-ai.vercel.app

# Resend Email Service Integration (Required in production for email verification & password resets)
RESEND_API_KEY=re_1234567890abcdef
EMAIL_FROM=CareerLens AI <noreply@careerlens.ai>

# Port Configuration for Local Server
PORT=8000
